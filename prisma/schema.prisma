// Prisma schema for Speedcubing Central
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  USER
}

enum Penalty {
  NONE
  DNF
}

enum BattleStatus {
  WAITING
  ACTIVE
  FINISHED
}

enum RelayStatus {
  LOBBY
  ASSIGNING
  ACTIVE
  FINISHED
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  passwordHash String?
  wcaId        String?  @unique
  displayName  String
  country      String?
  avatarUrl    String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  // Bumped on logout/password change to revoke all outstanding refresh
  // tokens for this user — a refresh token's embedded tokenVersion must
  // match this value or it's rejected. See server/src/routes/auth.ts.
  tokenVersion Int      @default(0)
  // Grants access to the beta deployment (beta.speedcubingcentral.com) —
  // enforced by server/src/auth/betaGate.ts whenever that deployment's
  // BETA_SITE env var is set. Toggled manually per-account (e.g. via
  // `npm run prisma:studio`) — there's no admin UI for this, matching the
  // "no admin role" convention below.
  betaAccess   Boolean  @default(false)

  sessions      Session[]
  solves        Solve[]
  battleParts   BattleParticipant[]
  algProgress   AlgProgress[]
  algPrefs      UserAlgPref[]
  algSolves     AlgSolve[]
  algSelections AlgSetSelection[]
  reconstructions Reconstruction[]
  customRelays    CustomRelay[]
  relayAttempts   RelayAttempt[]
  relayParts      RelayParticipant[]

  @@index([wcaId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  name      String
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  solves Solve[]

  @@index([userId, eventId])
}

model Solve {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  time      Int // milliseconds (or, for FMC, a move count)
  penalty   Penalty  @default(NONE)
  // Number of stacked +2s (0-8), only meaningful when penalty is NONE — a
  // DNF always has this at 0 (see server/src/routes/solves.ts's zeroing).
  plusTwoCount Int   @default(0)
  scramble  String
  // FMC only: the actual move sequence submitted, so a past attempt can be
  // reviewed later — null for every other event, and for an FMC solve that
  // was given up on or timed out before anything was submitted.
  solution  String?
  // Free-text note a user can attach after the fact (any event) — e.g. "PB!
  // safety solve" or "messed up the OLL". Null until they add one.
  comment   String?
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Covers both "solves for this session" and the createdAt-desc ordering
  // that listing always applies, so large sessions (thousands of solves,
  // e.g. after a bulk import) don't need a separate sort step.
  @@index([sessionId, createdAt])
}

// A single timed attempt at one algorithm-library case (Trainer tab), scoped
// to (user, set, case) rather than a session — PBs/stats need the full
// history per case, not just one practice session's worth.
model AlgSolve {
  id        String   @id @default(cuid())
  userId    String
  setId     String
  caseId    String
  time      Int // milliseconds
  penalty   Penalty  @default(NONE)
  // Number of stacked +2s (0-8), only meaningful when penalty is NONE —
  // see Solve.plusTwoCount above.
  plusTwoCount Int   @default(0)
  scramble  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, setId])
}

model BattleRoom {
  id          String       @id @default(cuid())
  name        String       @default("")
  code        String       @unique
  eventId     String       @default("333")
  // Non-null for an algorithm-set battle (e.g. "PLL") — each round then
  // draws a random case+AUF from that set instead of a full scramble.
  // eventId is still always set to the puzzle the set belongs to
  // ('333'/'222'), derived server-side, purely so existing scramble
  // rendering keeps working unmodified. See shared/src/algScramble.ts.
  algSetId    String?
  // Participant.id of the current room host (whoever created the room, or
  // whoever's been in it longest among current participants if the original
  // host left) — see server/src/socket.ts's join_room/leaveRoomCleanup for
  // how this is maintained. Not a Prisma relation on purpose:
  // BattleParticipant rows are deleted directly rather than cascaded from
  // BattleRoom, so this is managed entirely in application code rather than
  // via FK constraints.
  hostParticipantId String?
  isPublic    Boolean      @default(true)
  password    String?
  scramble    String       @default("")
  roundNumber Int          @default(0)
  status      BattleStatus @default(WAITING)
  createdAt   DateTime     @default(now())

  participants BattleParticipant[]
}

model BattleParticipant {
  id         String    @id @default(cuid())
  roomId     String
  userId     String?
  guestName  String?
  points     Int       @default(0)
  time       Int?
  penalty    Penalty?
  // Number of stacked +2s (0-8), only meaningful when penalty is NONE —
  // see Solve.plusTwoCount above.
  plusTwoCount Int     @default(0)
  finishedAt DateTime?

  room BattleRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId])
}

enum AlgStatus {
  NEW
  LEARNING
  LEARNED
}

// Per-user algorithm preferences: custom main alg + learning status
model UserAlgPref {
  id           String    @id @default(cuid())
  userId       String
  setId        String
  caseId       String
  status       AlgStatus @default(NEW)
  preferredAlg String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, setId, caseId])
  @@index([userId, setId])
}

// Which cases a user last chose to drill within one algorithm set (Trainer
// tab's "Select Cases" screen) — restored on their next visit so they can
// jump straight into training instead of re-picking from scratch.
model AlgSetSelection {
  id        String   @id @default(cuid())
  userId    String
  setId     String
  caseIds   String[]
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, setId])
}

// Spaced repetition progress for algorithm trainer (SM-2)
model AlgProgress {
  id           String   @id @default(cuid())
  userId       String
  setId        String // OLL, PLL, ...
  caseId       String
  easeFactor   Float    @default(2.5)
  intervalDays Int      @default(0)
  repetitions  Int      @default(0)
  dueAt        DateTime @default(now())
  lastReviewed DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, setId, caseId])
}

// A saved scramble + solution (move-by-move 3D reconstruction), shareable by id.
model Reconstruction {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("")
  eventId   String
  scramble  String
  solution  String
  timeMs    Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A saved custom relay definition (e.g. "my 2x 3x3 + megaminx mix"),
// shareable by id — mirrors Reconstruction's public-read-by-id pattern.
// `events` is deliberately a Json column (not a relation table): it's
// always read/written as one atomic ordered list, never queried per-row,
// unlike RelayRoomLeg below which needs real per-row fields during a live
// run.
model CustomRelay {
  id        String   @id @default(cuid())
  userId    String
  name      String
  events    Json // { eventId: string; quantity: number }[]
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A completed relay attempt (solo, or one participant's own slice of a
// completed team relay), for personal history/PBs.
model RelayAttempt {
  id          String   @id @default(cuid())
  userId      String
  relayName   String // denormalized so history stays meaningful if a CustomRelay is later edited/deleted
  totalTimeMs Int
  createdAt   DateTime @default(now())

  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  legs RelayAttemptLeg[]

  @@index([userId])
}

model RelayAttemptLeg {
  id        String @id @default(cuid())
  attemptId String
  eventId   String
  order     Int
  scramble  String
  splitMs   Int?

  attempt RelayAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

// A real-time team relay room — same code/host/password shape as
// BattleRoom, but relay-specific state (event assignment, shared clock)
// instead of round/scramble racing fields.
model RelayRoom {
  id     String @id @default(cuid())
  name   String @default("")
  code   String @unique
  // Participant.id of the current host — plain string, not an FK, same
  // non-relation convention as BattleRoom.hostParticipantId (managed in
  // application code since participants are deleted directly rather than
  // cascaded from here in every case).
  hostParticipantId String?
  isPublic Boolean @default(true)
  password String?
  // Exactly one of these is set — which relay definition this room runs.
  presetId      String?
  customRelayId String?
  status        RelayStatus @default(LOBBY)
  startedAt     DateTime? // set once, the moment the first holder releases — the shared clock's t=0
  finishedAt    DateTime? // set once, the moment the last participant signals done
  createdAt     DateTime    @default(now())

  participants RelayParticipant[]
  legs         RelayRoomLeg[]
}

model RelayRoomLeg {
  id           String  @id @default(cuid())
  roomId       String
  eventId      String
  order        Int // position in the relay; disambiguates duplicate events (e.g. two 3x3 legs)
  scramble     String  @default("") // filled in once assignment locks (on the start-triggering release)
  assignedToId String? // RelayParticipant.id, null until dragged onto someone
  splitMs      Int?

  room RelayRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model RelayParticipant {
  id        String  @id @default(cuid())
  roomId    String
  userId    String?
  guestName String?
  isReady   Boolean @default(false) // assignment-phase "I'm happy with this" checkbox
  isDone    Boolean @default(false) // pressed spacebar to signal "finished all my legs"

  room RelayRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId])
}
